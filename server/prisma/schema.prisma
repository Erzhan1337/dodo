generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  password     String
  address      String?
  refreshToken String?  @map("refresh_token")
  role         UserRole @default(CUSTOMER)

  cart                 Cart?
  orders               Order[]
  reviews              ProductReview[]
  favorites            ProductFavorite[]
  promoCodeRedemptions PromoCodeRedemption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                  String  @id @default(cuid())
  name                String
  imageUrl            String
  description         String
  canBuildHalfAndHalf Boolean @default(false) @map("can_build_half_and_half")
  ratingAvg           Float   @default(0) @map("rating_avg")
  ratingSum           Int     @default(0) @map("rating_sum")
  ratingCount         Int     @default(0) @map("rating_count")

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int      @map("category_id")

  ingredients Ingredient[]
  items       ProductItem[]
  reviews     ProductReview[]
  favorites   ProductFavorite[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([ratingAvg, ratingCount])
  @@map("products")
}

model ProductItem {
  id        String @id @default(cuid())
  price     Int
  size      Int?
  pizzaType Int?   @map("pizza_type")
  imageUrl  String

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, size, price])
  @@index([price])
  @@map("product_items")
}

model Ingredient {
  id       String @id @default(cuid())
  name     String
  price    Int
  imageUrl String

  products   Product[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ingredients")
}

model Order {
  id             String @id @default(cuid())
  orderNumber    Int    @unique @default(autoincrement()) @map("order_number")
  subtotalPrice  Int    @default(0) @map("subtotal_price")
  discountAmount Int    @default(0) @map("discount_amount")
  totalPrice     Int    @default(0) @map("total_price")
  status         STATUS
  token          String

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @map("user_id")

  items               OrderItem[]
  payment             Payment?
  promoCodeRedemption PromoCodeRedemption?

  promoCode         PromoCode? @relation(fields: [promoCodeId], references: [id])
  promoCodeId       String?    @map("promo_code_id")
  promoCodeSnapshot Json?      @map("promo_code_snapshot")

  name    String
  phone   String
  address String
  email   String?
  comment String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([promoCodeId])
  @@index([orderNumber])
  @@map("orders")
}

model Payment {
  id                      String          @id @default(cuid())
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  amount                  Int
  currency                String
  providerCheckoutId      String?         @unique @map("provider_checkout_id")
  providerPaymentIntentId String?         @unique @map("provider_payment_intent_id")
  checkoutUrl             String?         @map("checkout_url")
  paidAt                  DateTime?       @map("paid_at")
  canceledAt              DateTime?       @map("canceled_at")
  failedAt                DateTime?       @map("failed_at")

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique @map("order_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String          @unique @map("provider_event_id")
  type            String
  processedAt     DateTime        @default(now()) @map("processed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("payment_webhook_events")
}

model OrderItem {
  id String @id @default(cuid())

  productItem   ProductItem @relation(fields: [productItemId], references: [id])
  productItemId String      @map("product_item_id")

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @map("order_id")

  quantity      Int
  price         Int
  customName    String? @map("custom_name")
  customDetails Json?   @map("custom_details")

  ingredients Ingredient[]
  review      ProductReview?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productItemId])
  @@map("order_items")
}

model ProductReview {
  id      String  @id @default(cuid())
  rating  Int
  comment String?

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String    @unique @map("order_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([rating])
  @@map("product_reviews")
}

model ProductFavorite {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favorite_products")
}

model Cart {
  id             String  @id @default(cuid())
  subtotalPrice  Int     @default(0) @map("subtotal_price")
  discountAmount Int     @default(0) @map("discount_amount")
  totalPrice     Int     @default(0) @map("total_price")
  guestToken     String? @unique @map("guest_token")

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique @map("user_id")

  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  promoCodeId String?    @map("promo_code_id")

  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([promoCodeId])
  @@map("carts")
}

model CartItem {
  id              String  @id @default(cuid())
  quantity        Int     @default(1)
  ingredientsKey  String  @default("") @map("ingredients_key")
  customName      String? @map("custom_name")
  customDetails   Json?   @map("custom_details")
  customUnitPrice Int?    @map("custom_unit_price")

  productItem   ProductItem @relation(fields: [productItemId], references: [id])
  productItemId String      @map("product_item_id")

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String @map("cart_id")

  ingredients Ingredient[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productItemId, ingredientsKey])
  @@index([cartId, createdAt])
  @@index([productItemId])
  @@map("cart_items")
}

model PromoCode {
  id                String        @id @default(cuid())
  code              String        @unique
  title             String
  description       String
  type              PromoCodeType
  value             Int
  minOrderAmount    Int           @default(0) @map("min_order_amount")
  maxDiscountAmount Int?          @map("max_discount_amount")
  usageLimit        Int?          @map("usage_limit")
  perUserLimit      Int?          @map("per_user_limit")
  firstOrderOnly    Boolean       @default(false) @map("first_order_only")
  isActive          Boolean       @default(true) @map("is_active")
  startsAt          DateTime?     @map("starts_at")
  endsAt            DateTime?     @map("ends_at")

  carts       Cart[]
  orders      Order[]
  redemptions PromoCodeRedemption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, startsAt, endsAt])
  @@map("promo_codes")
}

model PromoCodeRedemption {
  id             String @id @default(cuid())
  discountAmount Int    @map("discount_amount")

  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  promoCodeId String    @map("promo_code_id")

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique @map("order_id")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([promoCodeId, createdAt])
  @@index([userId, promoCodeId])
  @@map("promo_code_redemptions")
}

enum STATUS {
  NEW
  PREPARING
  DELIVERING
  COMPLETED
  CANCELED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
}

enum PromoCodeType {
  PERCENT
  FIXED_AMOUNT
}
